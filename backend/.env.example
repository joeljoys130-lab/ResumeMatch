# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/resumematch_db?schema=public"

# MongoDB Database (Mongoose)
MONGODB_URI="mongodb://localhost:27017/resumematch"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Authentication & JWT
JWT_SECRET="supersecretjwtkeyforresumematchai2026!"
JWT_EXPIRES_IN="7d"

# Optional Google OAuth 2.0 (Leaves empty if not configuring GCP)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-your-api-key-here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# RAG Embedding Model Configuration
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# Default Dev Admin Account Setup
